@base <http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem/> .

<http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem> rdf:type owl:Ontology ;
                                                                  rdfs:comment "Онтология солнечной системы"@ru .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#HasSatellite
:HasSatellite rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              owl:inverseOf :orbits .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#orbits
:orbits rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty ;
        rdfs:domain [ rdf:type owl:Restriction ;
                      owl:onProperty :orbits ;
                      owl:allValuesFrom :AstronomicalBody
                    ] ;
        rdfs:range [ rdf:type owl:Restriction ;
                     owl:onProperty :orbits ;
                     owl:someValuesFrom :AstronomicalBody
                   ] .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#HasMass
:HasMass rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#distanceFromSun
:distanceFromSun rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#hasRadius
:hasRadius rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#AstronomicalBody
:AstronomicalBody rdf:type owl:Class .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#Gas
:Gas rdf:type owl:Class ;
     rdfs:subClassOf :Planet .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#Ice
:Ice rdf:type owl:Class ;
     rdfs:subClassOf :Planet .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#NaturalSatellite
:NaturalSatellite rdf:type owl:Class ;
                  rdfs:subClassOf :AstronomicalBody .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#Planet
:Planet rdf:type owl:Class ;
        rdfs:subClassOf :AstronomicalBody .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#Star
:Star rdf:type owl:Class ;
      rdfs:subClassOf :AstronomicalBody .


###  http://www.semanticweb.org/matve/ontologies/2026/8/SolarSystem#Terrestial
:Terrestial rdf:type owl:Class ;
            rdfs:subClassOf :Planet .


